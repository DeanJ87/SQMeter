# Basics every editor understands; the formatters (coding standard FMT-01) do the rest.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,ino}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,json,css,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
