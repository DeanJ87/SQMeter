{
  "about": "Numeric setting ranges, shared by the device (test/test_config_ranges) and the web UI (web/src/__tests__/configRanges.test.ts) so they can't drift (spec 011 FR-004 / SC-001). Each range is checked at min and max (accepted) and just outside (rejected). `gt` / `lt` mean strictly greater / less than the bound. `with` sets companion settings so a cross-field rule doesn't interfere.",
  "ranges": [
    { "path": "wifi.reconnectDelayMs", "int": true, "min": 1, "max": 86400000, "with": { "wifi.maxReconnectDelayMs": 86400000 } },
    { "path": "wifi.maxReconnectDelayMs", "int": true, "min": 1, "max": 86400000, "with": { "wifi.reconnectDelayMs": 1 } },
    { "path": "mqtt.port", "int": true, "min": 1, "max": 65535 },
    { "path": "mqtt.publishIntervalMs", "int": true, "min": 1000, "max": 86400000 },
    { "path": "ntp.syncIntervalMs", "int": true, "min": 600000, "max": 86400000 },
    { "path": "sensor.readIntervalMs", "int": true, "min": 100, "max": 3600000 },
    { "path": "sensor.i2cFrequency", "int": true, "min": 10000, "max": 400000 },
    { "path": "skyAveraging.windowSeconds", "int": true, "min": 10, "max": 300 },
    { "path": "skyCalibration.sqmOffset", "min": -5, "max": 5 },
    { "path": "cloudDetection.clearSkyThreshold", "min": -30, "max": 0, "with": { "cloudDetection.cloudyThreshold": 5 } },
    { "path": "cloudDetection.cloudyThreshold", "min": -20, "max": 10, "with": { "cloudDetection.clearSkyThreshold": -25 } },
    { "path": "cloudDetection.humidityCorrection", "min": 0, "max": 2 },
    { "path": "alpaca.staleAfterSeconds", "int": true, "min": 1, "max": 3600 },
    { "path": "alpaca.cloudCoverUnsafePercent", "min": 0, "max": 100 },
    { "path": "alpaca.sqmMinSafe", "min": 0, "max": 30 },
    { "path": "alpaca.humidityMaxSafe", "min": 0, "max": 100 },
    { "path": "alpaca.dewpointMarginMinC", "min": 0, "max": 20 },
    { "path": "alpaca.safeDelaySeconds", "int": true, "min": 0, "max": 3600 },
    { "path": "alpaca.windSpeedUnsafeMs", "gt": 0, "max": 60 },
    { "path": "alpaca.windGustUnsafeMs", "gt": 0, "max": 80 },
    { "path": "wind.kmhPerHz", "gt": 0, "max": 20 },
    { "path": "wind.directionOffsetDeg", "min": -360, "max": 360 },
    { "path": "wind.vanePullupOhms", "min": 1000, "max": 100000 },
    { "path": "rain.pollIntervalMs", "int": true, "min": 1000, "max": 3600000 },
    { "path": "rain.rainClearDelayMs", "int": true, "min": 60000, "max": 86400000 },
    { "path": "rain.dailyResetHour", "int": true, "min": 0, "max": 23 },
    { "path": "rain.dailyResetMinute", "int": true, "min": 0, "max": 59 },
    { "path": "alerts.dewRiskMarginC", "min": 0, "max": 10 },
    { "path": "alerts.clearSkyCloudPercent", "min": 0, "lt": 100, "with": { "alerts.cloudedOverCloudPercent": 100 } },
    { "path": "alerts.cloudedOverCloudPercent", "gt": 0, "max": 100, "with": { "alerts.clearSkyCloudPercent": 0 } },
    { "path": "alerts.nightSunAltitudeDeg", "min": -20, "max": 0 },
    { "path": "alerts.cooldownSeconds", "int": true, "min": 0, "max": 86400 },
    { "path": "alerts.clientSilentSafetySeconds", "int": true, "min": 30, "max": 3600 },
    { "path": "alerts.clientSilentWeatherSeconds", "int": true, "min": 30, "max": 3600 },
    { "path": "location.latitude", "min": -90, "max": 90, "with": { "location.set": true } },
