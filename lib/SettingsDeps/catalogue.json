    { "id": "D-14", "class": "dependency", "kind": "setting", "neutral": true, "settings": ["mqtt.publish.gps", "mqtt.publish.rain", "mqtt.publish.wind"], "dependsOn": "MQTT on and GPS / rain sensor / anemometer on", "reasons": ["mqtt-off", "gps-off", "rain-off", "wind-off"] },
    { "id": "D-15", "class": "dependency", "kind": "setting", "neutral": true, "unmet": "inactive", "settings": ["alpaca.rainUnsafeEnabled", "alpaca.rainSensorRequired"], "dependsOn": "Rain sensor on", "reasons": ["rain-off"] },
    { "id": "D-16", "class": "dependency", "kind": "setting", "unmet": "fail-safe", "settings": ["alpaca.windSpeedUnsafeEnabled", "alpaca.windGustUnsafeEnabled"], "dependsOn": "Anemometer on", "reasons": ["wind-off"] },
    { "id": "D-17", "class": "dependency", "kind": "setting", "runtime": true, "unmet": "fail-safe", "settings": ["alpaca.cloudCoverEnabled"], "dependsOn": "MLX90614 detected", "reasons": ["infrared-missing"] },
    { "id": "D-18", "class": "dependency", "kind": "setting", "runtime": true, "unmet": "fail-safe", "settings": ["alpaca.sqmMinEnabled"], "dependsOn": "TSL2591 detected", "reasons": ["light-missing"] },
    { "id": "D-19", "class": "dependency", "kind": "setting", "runtime": true, "unmet": "fail-safe", "settings": ["alpaca.humidityMaxEnabled", "alpaca.dewpointMarginEnabled"], "dependsOn": "BME280 detected", "reasons": ["environment-missing"] },
    { "id": "D-20", "class": "dependency", "kind": "feature", "settings": ["alpaca.enabled"], "dependsOn": "Alpaca on - IsSafe and ObservingConditions served; the Alpaca page explains when it is off", "reasons": [] },
    { "id": "D-21", "class": "dependency", "kind": "feature", "settings": ["rain.enabled"], "dependsOn": "Rain sensor on - Alpaca RainRate is NotImplemented otherwise", "reasons": [] },
    { "id": "D-22", "class": "dependency", "kind": "feature", "settings": ["wind.enabled", "wind.directionEnabled"], "dependsOn": "Anemometer on (direction: wind vane on) - Alpaca wind properties are NotImplemented otherwise", "reasons": [] },
    { "id": "D-23", "class": "dependency", "kind": "setting", "settings": ["wind.directionEnabled"], "dependsOn": "Anemometer on", "reasons": ["wind-off"] },
    { "id": "D-24", "class": "dependency", "kind": "setting", "settings": ["rain.dailyResetEnabled"], "dependsOn": "Rain sensor on; device clock set (NTP or GPS time)", "reasons": ["rain-off", "clock-unset"] },
    { "id": "D-25", "class": "dependency", "kind": "setting", "neutral": true, "settings": ["location.showSunMoon"], "dependsOn": "Location set or GPS fix", "reasons": ["location-unknown"] },
