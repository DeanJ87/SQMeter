{
  "$comment": "Settings dependency catalogue (specs/020-settings-dependencies). Source of truth for tools/settings-deps/check.py and docs/reference/settings-dependencies.md. lib/SettingsDeps and web/src/lib/settingsDeps.ts implement every reported entry; test/fixtures/settings-deps/cases.json holds them to the same answers. Every setting (test/fixtures/settings-deps/default-config.json and config-ranges.json) is either in an entry or in noDependency: its effect needs nothing outside its own section (a section's own switch and the toggle a value belongs to don't count). Patterns use * for one path segment.",
  "noDependency": [
    "deviceName",
    "wifi.ssid", "wifi.password", "wifi.hostname", "wifi.autoReconnect", "wifi.reconnectDelayMs", "wifi.maxReconnectDelayMs",
    "mqtt.enabled", "mqtt.port", "mqtt.username", "mqtt.password", "mqtt.publishIntervalMs", "mqtt.publish.sky", "mqtt.publish.environment", "mqtt.publish.clouds", "mqtt.publish.safety", "mqtt.publish.diagnostics", "mqtt.homeAssistant.discoveryPrefix",
    "ota.password",
    "auth.enabled", "auth.username",
    "ntp.server1", "ntp.server2", "ntp.timezone", "ntp.syncIntervalMs",
    "gps.rxPin", "gps.txPin", "gps.baudRate",
    "rain.rxPin", "rain.txPin", "rain.baudRate", "rain.debugUart", "rain.mode", "rain.resolution", "rain.units", "rain.pollIntervalMs", "rain.rainClearDelayMs", "rain.dailyResetHour", "rain.dailyResetMinute",
    "sensor.readIntervalMs", "sensor.i2cSDA", "sensor.i2cSCL", "sensor.i2cFrequency",
    "skyAveraging.windowSeconds",
    "skyCalibration.sqmOffset", "skyCalibration.darkVisibleOffset", "skyCalibration.darkFullOffset", "skyCalibration.darkIrOffset", "skyCalibration.darkSampleCount", "skyCalibration.darkCalibratedAt",
    "sky.sqmEnabled", "skyAveragingL.windowSeconds",
    "skyCalibrationL.sqmOffset", "skyCalibrationL.darkVisibleOffset", "skyCalibrationL.darkFullOffset", "skyCalibrationL.darkIrOffset", "skyCalibrationL.darkSampleCount", "skyCalibrationL.darkCalibratedAt",
    "cloudDetection.clearSkyThreshold", "cloudDetection.cloudyThreshold", "cloudDetection.humidityCorrection",
    "alpaca.manualOverrideUnsafe", "alpaca.staleAfterSeconds", "alpaca.cloudCoverUnsafePercent", "alpaca.sqmMinSafe", "alpaca.humidityMaxSafe", "alpaca.dewpointMarginMinC", "alpaca.safeDelaySeconds", "alpaca.windSpeedUnsafeMs", "alpaca.windGustUnsafeMs", "alpaca.batteryMinPercent", "alpaca.batteryAlert",
    "ble.passkey",
    "location.set", "location.latitude", "location.longitude",
    "wind.speedPin", "wind.directionPin", "wind.kmhPerHz", "wind.directionOffsetDeg", "wind.vanePullupOhms",
    "display.enabled",
    "alerts.enabled", "alerts.clientSilentSafetySeconds", "alerts.clientSilentWeatherSeconds", "alerts.dewRiskMarginC", "alerts.clearSkyCloudPercent", "alerts.cloudedOverCloudPercent", "alerts.armWithAlpaca", "alerts.cooldownSeconds", "alerts.pushover.userKey", "alerts.pushover.appToken", "alerts.pushover.sound", "alerts.ntfy.server", "alerts.ntfy.topic", "alerts.ntfy.token", "alerts.webhook.url", "alerts.webhook.authHeader", "alerts.webhook.insecureTls",
    "alerts.events.*.sound", "alerts.events.*.title", "alerts.events.*.message"
  ],
  "reasons": {
    "alerts-off": { "text": "Alerts are off", "fix": "alerts#alerts" },
    "mqtt-off": { "text": "MQTT is off", "fix": "network#mqtt" },
    "mqtt-disconnected": { "text": "Broker not connected", "fix": "network#mqtt" },
    "wifi-disconnected": { "text": "Not connected to WiFi", "fix": "network#wifi" },
    "rain-off": { "text": "Rain sensor is off", "fix": "sensors#rain" },
    "wind-off": { "text": "Anemometer is off", "fix": "sensors#wind" },
    "gps-off": { "text": "GPS is off", "fix": "time#time-sources" },
    "gps-restart": { "text": "GPS starts after a restart", "fix": "restart" },
    "gps-no-fix": { "text": "No GPS fix - using the location in Settings", "fix": "time#location" },
    "light-missing": { "text": "Light sensor not detected", "fix": "sensors#sky-sensors" },
    "sqm-missing": { "text": "SQM not detected", "fix": "sensors#sky-sensors" },
    "sky-single": { "text": "SQM and SQM-L must both be on", "fix": "sensors#sky-sensors" },
    "sqml-missing": { "text": "SQM-L not detected", "fix": "sensors#sky-sensors" },
    "i2c2-unset": { "text": "Second I2C bus pins not set", "fix": "sensors#sky-sensors" },
    "infrared-missing": { "text": "IR sky sensor not detected", "fix": "sensors#sky-sensors" },
    "environment-missing": { "text": "Environment sensor not detected", "fix": "sensors#sky-sensors" },
    "location-unknown": { "text": "Needs your location", "fix": "time#location" },
    "alpaca-off": { "text": "Alpaca is off", "fix": "safety#alpaca" },
    "ble-build": { "text": "Needs the Bluetooth firmware build", "fix": "device#ble" },
    "ble-off": { "text": "Bluetooth is off", "fix": "device#ble" },
    "ble-restart": { "text": "Bluetooth starts after a restart", "fix": "restart" },
    "no-passkey": { "text": "No pairing passkey set", "fix": "device#ble" },
    "no-phones": { "text": "No phone paired", "fix": "device#ble" },
    "clock-unset": { "text": "The device doesn't know the time yet", "fix": "time#time-sources" },
    "language-offline": { "text": "Needs WiFi to download - or upload the file", "fix": "network#wifi" },
    "ota-no-password": { "text": "Set an upload password", "fix": "device#security" },
    "display-missing": { "text": "No display detected", "fix": "device#display" },
    "battery-missing": { "text": "No battery gauge detected", "fix": "device#battery" }
  },
  "entries": [
    { "id": "D-01", "class": "dependency", "kind": "setting", "settings": ["alerts.mqtt.enabled"], "dependsOn": "MQTT on", "reasons": ["mqtt-off"] },
    { "id": "D-02", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["alerts.mqtt.enabled"], "dependsOn": "MQTT broker connected", "reasons": ["mqtt-disconnected"] },
    { "id": "D-03", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["alerts.pushover.enabled", "alerts.ntfy.enabled", "alerts.webhook.enabled"], "dependsOn": "WiFi connected to a network (not the setup hotspot)", "reasons": ["wifi-disconnected"] },
    { "id": "D-04", "class": "dependency", "kind": "setting", "settings": ["alerts.pushover.enabled", "alerts.ntfy.enabled", "alerts.webhook.enabled", "alerts.mqtt.enabled", "alerts.events.unsafe.level", "alerts.events.safe.level", "alerts.events.rain_started.level", "alerts.events.rain_stopped.level", "alerts.events.sensor_fault.level", "alerts.events.sensor_recovered.level", "alerts.events.dew_risk.level", "alerts.events.clear_sky.level", "alerts.events.clouded_over.level", "alerts.events.client_lost.level", "alerts.events.client_back.level", "alerts.events.client_disconnected.level", "alerts.skyNightOnly", "alerts.safetyNightOnly", "alerts.nightSunAltitudeDeg", "alerts.sendMode"], "dependsOn": "Alerts on (Send alerts). Events at Wake me, arming and the night-only options also count while paired phones can ring; channels are push only", "reasons": ["alerts-off"] },
    { "id": "D-05", "class": "dependency", "kind": "setting", "settings": ["alerts.events.rain_started.level", "alerts.events.rain_stopped.level"], "dependsOn": "Rain sensor on", "reasons": ["rain-off"] },
    { "id": "D-06", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["alerts.events.dew_risk.level"], "dependsOn": "BME280 detected", "reasons": ["environment-missing"] },
    { "id": "D-07", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["alerts.events.clear_sky.level", "alerts.events.clouded_over.level"], "dependsOn": "MLX90614 detected", "reasons": ["infrared-missing"] },
    { "id": "D-08", "class": "dependency", "kind": "setting", "neutral": true, "settings": ["alerts.wakePhones"], "dependsOn": "Bluetooth build, Bluetooth on, passkey set, at least one paired phone (Wake me still escalates Pushover and ntfy)", "reasons": ["ble-build", "ble-off", "no-passkey", "no-phones"] },
    { "id": "D-09", "class": "dependency", "kind": "setting", "settings": ["alerts.skyNightOnly"], "dependsOn": "Location set or GPS fix", "reasons": ["location-unknown"] },
    { "id": "D-10", "class": "dependency", "kind": "setting", "settings": ["alerts.safetyNightOnly"], "dependsOn": "Location set or GPS fix", "reasons": ["location-unknown"] },
    { "id": "D-11", "class": "dependency", "kind": "setting", "settings": ["alerts.nightSunAltitudeDeg"], "dependsOn": "Either night-only option on (off otherwise)", "reasons": [] },
    { "id": "D-12", "class": "dependency", "kind": "setting", "settings": ["alerts.sendMode"], "dependsOn": "Alpaca on - \"Only while an imaging app is connected\" (spec 021); while Alpaca is off, alerts go out any time", "reasons": ["alpaca-off"] },
    { "id": "D-13", "class": "dependency", "kind": "setting", "settings": ["mqtt.homeAssistant.enabled", "mqtt.homeAssistant.alertsSwitch"], "dependsOn": "MQTT on; the Alerts switch also needs alerts on (or paired phones that can ring)", "reasons": ["mqtt-off", "alerts-off"] },
    { "id": "D-14", "class": "dependency", "kind": "setting", "neutral": true, "settings": ["mqtt.publish.gps", "mqtt.publish.rain", "mqtt.publish.wind"], "dependsOn": "MQTT on and GPS / rain sensor / anemometer on", "reasons": ["mqtt-off", "gps-off", "rain-off", "wind-off"] },
    { "id": "D-15", "class": "dependency", "kind": "setting", "neutral": true, "unmet": "inactive", "settings": ["alpaca.rainUnsafeEnabled", "alpaca.rainSensorRequired"], "dependsOn": "Rain sensor on", "reasons": ["rain-off"] },
    { "id": "D-16", "class": "dependency", "kind": "setting", "unmet": "fail-safe", "settings": ["alpaca.windSpeedUnsafeEnabled", "alpaca.windGustUnsafeEnabled"], "dependsOn": "Anemometer on", "reasons": ["wind-off"] },
    { "id": "D-17", "class": "dependency", "kind": "setting", "runtime": true, "unmet": "fail-safe", "settings": ["alpaca.cloudCoverEnabled"], "dependsOn": "MLX90614 detected", "reasons": ["infrared-missing"] },
    { "id": "D-18", "class": "dependency", "kind": "setting", "runtime": true, "unmet": "fail-safe", "settings": ["alpaca.sqmMinEnabled"], "dependsOn": "The authoritative sky sensor (TSL2591) detected; named SQM or SQM-L when both are on (spec 030)", "reasons": ["light-missing", "sqm-missing", "sqml-missing"] },
    { "id": "D-19", "class": "dependency", "kind": "setting", "runtime": true, "unmet": "fail-safe", "settings": ["alpaca.humidityMaxEnabled", "alpaca.dewpointMarginEnabled"], "dependsOn": "BME280 detected", "reasons": ["environment-missing"] },
    { "id": "D-20", "class": "dependency", "kind": "feature", "settings": ["alpaca.enabled"], "dependsOn": "Alpaca on - IsSafe and ObservingConditions served; the Alpaca page explains when it is off", "reasons": [] },
    { "id": "D-21", "class": "dependency", "kind": "feature", "settings": ["rain.enabled"], "dependsOn": "Rain sensor on - Alpaca RainRate is NotImplemented otherwise", "reasons": [] },
    { "id": "D-22", "class": "dependency", "kind": "feature", "settings": ["wind.enabled", "wind.directionEnabled"], "dependsOn": "Anemometer on (direction: wind vane on) - Alpaca wind properties are NotImplemented otherwise", "reasons": [] },
    { "id": "D-23", "class": "dependency", "kind": "setting", "settings": ["wind.directionEnabled"], "dependsOn": "Anemometer on", "reasons": ["wind-off"] },
    { "id": "D-24", "class": "dependency", "kind": "setting", "settings": ["rain.dailyResetEnabled"], "dependsOn": "Rain sensor on; device clock set (NTP or GPS time)", "reasons": ["rain-off", "clock-unset"] },
    { "id": "D-25", "class": "dependency", "kind": "setting", "neutral": true, "settings": ["location.showSunMoon"], "dependsOn": "Location set or GPS fix", "reasons": ["location-unknown"] },
    { "id": "D-26", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["gps.enabled"], "dependsOn": "GPS running and a GPS fix (location source)", "reasons": ["gps-no-fix"] },
    { "id": "D-27", "class": "constraint", "kind": "feature", "settings": ["primaryTimeSource", "secondaryTimeSource", "ntp.enabled", "gps.enabled"], "dependsOn": "At least one time source on; primary and secondary sources on and different", "reasons": [], "messages": ["At least one time source must be enabled", "Primary time source is disabled", "Secondary time source is disabled", "Time sources must be different when both NTP and GPS are enabled"] },
    { "id": "D-28", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["ntp.enabled"], "dependsOn": "WiFi connected to a network", "reasons": ["wifi-disconnected"] },
    { "id": "D-29", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["skyCalibration.enabled"], "dependsOn": "SQM (TSL2591 on I2C-1) detected; named SQM when the SQM-L is on too (spec 030)", "reasons": ["light-missing", "sqm-missing"] },
    { "id": "D-30", "class": "dependency", "kind": "setting", "settings": ["ble.enabled", "ble.phoneAlarm"], "dependsOn": "Bluetooth firmware build", "reasons": ["ble-build"] },
    { "id": "D-31", "class": "dependency", "kind": "setting", "settings": ["ble.phoneAlarm"], "dependsOn": "Bluetooth on and a passkey set (the alarm is on while a passkey is set)", "reasons": ["ble-off"] },
    { "id": "D-32", "class": "dependency", "kind": "setting", "settings": ["ota.enabled"], "dependsOn": "An OTA upload password set", "reasons": ["ota-no-password"] },
    { "id": "D-33", "class": "constraint", "kind": "feature", "settings": ["mqtt.broker", "mqtt.topic"], "dependsOn": "MQTT on needs a broker and a topic", "reasons": [], "messages": ["MQTT broker and topic are required when MQTT is enabled"] },
    { "id": "D-34", "class": "constraint", "kind": "feature", "settings": ["auth.password"], "dependsOn": "HTTP auth on needs a password", "reasons": [], "messages": ["HTTP auth password is required when auth is enabled"] },
    { "id": "D-35", "class": "dependency", "kind": "setting", "settings": ["gps.enabled", "ble.enabled", "ble.phoneAlarm", "alerts.wakePhones", "mqtt.publish.gps"], "dependsOn": "A restart since GPS or Bluetooth was switched on (both start at boot)", "reasons": ["gps-restart", "ble-restart"] },
    { "id": "D-37", "class": "dependency", "kind": "setting", "settings": ["alerts.events.client_lost.level", "alerts.events.client_back.level", "alerts.events.client_disconnected.level"], "dependsOn": "Alpaca on - imaging apps connect over Alpaca (spec 021)", "reasons": ["alpaca-off"] },
    { "id": "D-36", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["wifi.mdns", "wifi.ipv6"], "dependsOn": "WiFi connected to a network (not the setup hotspot)", "reasons": ["wifi-disconnected"] },
    { "id": "D-38", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["language"], "dependsOn": "A language other than English needs its file: downloaded over WiFi from the GitHub release (needs internet), or uploaded by hand (works offline) (spec 023)", "reasons": ["language-offline"] },
    { "id": "D-39", "class": "dependency", "kind": "setting", "settings": ["sky.sqmlEnabled"], "dependsOn": "The second I2C bus pins set (spec 030)", "reasons": ["i2c2-unset"] },
    { "id": "D-40", "class": "dependency", "kind": "setting", "settings": ["sky.authoritative", "sky.showOther"], "dependsOn": "SQM and SQM-L both on (spec 030)", "reasons": ["sky-single"] },
    { "id": "D-41", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["skyCalibrationL.enabled"], "dependsOn": "SQM-L (TSL2591 on I2C-2) detected (spec 030)", "reasons": ["sqml-missing"] },
    { "id": "D-42", "class": "constraint", "kind": "feature", "settings": ["sensor.i2c2SDA", "sensor.i2c2SCL", "sky.sqmlEnabled"], "dependsOn": "Second I2C bus pins: both unset, or two different valid GPIOs no other bus uses; the SQM-L can't be saved on without them (spec 030)", "reasons": [], "messages": ["SQM-L needs the second I2C bus pins", "Second I2C bus pins are invalid", "Second I2C bus pins are already in use"] },
    { "id": "D-43", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["display.pages", "display.cycleSeconds", "display.brightness", "display.timeoutSeconds", "display.wakeOnBoot", "display.stayOnAtNight", "display.rotate180", "display.buttonPin"], "dependsOn": "An OLED display answering at 0x3C on the main I2C bus; a display that's off in settings is never probed (spec 031)", "reasons": ["display-missing"] },
    { "id": "D-44", "class": "dependency", "kind": "setting", "settings": ["display.stayOnAtNight"], "dependsOn": "Location set or GPS fix, so the device can tell when it's night; until then the display always times out (spec 031)", "reasons": ["location-unknown"] },
    { "id": "D-45", "class": "constraint", "kind": "feature", "settings": ["display.buttonPin"], "dependsOn": "Wake button pin: none (255), or a valid GPIO that I2C-1, I2C-2, GPS, the rain sensor, the anemometer and vane and the battery pins (gauge alert, STAT1, STAT2, PG) don't use while the display is on (specs 031, 032)", "reasons": [], "messages": ["Display: wake button pin is not a valid GPIO", "Display: wake button pin is already in use"] },
    { "id": "D-46", "class": "dependency", "kind": "setting", "runtime": true, "neutral": true, "settings": ["battery.enabled", "battery.lowPercent", "battery.criticalPercent", "battery.shutdownPercent", "battery.capacityMah", "battery.powerSaving", "battery.saveReadIntervalSeconds", "battery.shutdownGraceSeconds"], "dependsOn": "A MAX17048 fuel gauge answering at 0x36 on the main I2C bus; monitoring ships on, so without a gauge these are shown muted (spec 032)", "reasons": ["battery-missing"] },
    { "id": "D-47", "class": "dependency", "kind": "setting", "runtime": true, "unmet": "fail-safe", "settings": ["alpaca.batteryEnabled"], "dependsOn": "A fuel gauge; the battery rule without one (or with monitoring off) reports unsafe: Battery data missing (spec 032)", "reasons": ["battery-missing"] },
    { "id": "D-48", "class": "dependency", "kind": "setting", "runtime": true, "neutral": true, "settings": ["alerts.events.battery_low.level", "alerts.events.battery_critical.level", "alerts.events.battery_shutdown.level", "alerts.events.power_restored.level", "alerts.events.charge_complete.level", "alerts.events.charge_fault.level"], "dependsOn": "Alerts on (Wake me: or paired phones that ring) and a fuel gauge (spec 032)", "reasons": ["alerts-off", "battery-missing"] },
    { "id": "D-49", "class": "dependency", "kind": "setting", "neutral": true, "settings": ["mqtt.publish.battery"], "dependsOn": "MQTT on and a fuel gauge (spec 032)", "reasons": ["mqtt-off", "battery-missing"] },
    { "id": "D-50", "class": "dependency", "kind": "setting", "neutral": true, "settings": ["alpaca.batteryPhoneAlarm"], "dependsOn": "Bluetooth build, Bluetooth on, passkey set, at least one paired phone, as D-08 (spec 032)", "reasons": ["ble-build", "ble-off", "no-passkey", "no-phones"] },
    { "id": "D-51", "class": "constraint", "kind": "feature", "settings": ["battery.alertPin", "battery.stat1Pin", "battery.stat2Pin", "battery.pgPin"], "dependsOn": "Battery pins: none (255) or valid, different GPIOs; the charger's STAT1, STAT2 and PG together or not at all; not used by I2C-1, I2C-2, GPS, the rain sensor, the anemometer and vane or the display button; PG able to wake the device (spec 032)", "reasons": [], "messages": ["Battery: pins must be valid and different", "Battery: set all three charger pins or none", "Battery: pin is already in use", "Battery: the USB power pin must be able to wake the device"] }
  ]
}
