    { "id": "D-30", "class": "dependency", "kind": "setting", "settings": ["ble.enabled", "ble.phoneAlarm"], "dependsOn": "Bluetooth firmware build", "reasons": ["ble-build"] },
    { "id": "D-31", "class": "dependency", "kind": "setting", "settings": ["ble.phoneAlarm"], "dependsOn": "Bluetooth on and a passkey set (the alarm is on while a passkey is set)", "reasons": ["ble-off"] },
    { "id": "D-32", "class": "dependency", "kind": "setting", "settings": ["ota.enabled"], "dependsOn": "An OTA upload password set", "reasons": ["ota-no-password"] },
