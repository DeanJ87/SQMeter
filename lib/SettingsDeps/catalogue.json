    { "id": "D-34", "class": "constraint", "kind": "feature", "settings": ["auth.password"], "dependsOn": "HTTP auth on needs a password", "reasons": [], "messages": ["HTTP auth password is required when auth is enabled"] },
    { "id": "D-35", "class": "dependency", "kind": "setting", "settings": ["gps.enabled", "ble.enabled", "ble.phoneAlarm", "alerts.wakePhones", "mqtt.publish.gps"], "dependsOn": "A restart since GPS or Bluetooth was switched on (both start at boot)", "reasons": ["gps-restart", "ble-restart"] },
    { "id": "D-36", "class": "dependency", "kind": "setting", "runtime": true, "settings": ["wifi.mdns"], "dependsOn": "WiFi connected to a network (not the setup hotspot)", "reasons": ["wifi-disconnected"] }
