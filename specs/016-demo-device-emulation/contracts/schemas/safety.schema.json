{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "safety",
  "type": "object",
  "properties": {
    "alpacaEnabled": {
      "type": "boolean"
    },
    "changedAgeMs": {
      "type": "number"
    },
    "dew": {
      "type": "object",
      "properties": {
        "cloudCoverPercent": {
          "type": "number"
        },
        "rainIntensity": {
          "type": "number"
        },
        "sinceAgeMs": {
          "type": "number"
        }
      },
      "required": [
        "cloudCoverPercent",
        "rainIntensity",
        "sinceAgeMs"
      ],
      "additionalProperties": false
    },
    "dewSuspected": {
      "type": "boolean"
    },
    "evaluatedAgeMs": {
      "type": "number"
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expiresEpoch": {
            "type": "number"
          },
          "expiresInMs": {
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "sinceAgeMs": {
            "type": "number"
          },
          "sinceEpoch": {
            "type": "number"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "rawSafe": {
      "type": "boolean"
    },
    "reasonFlags": {
      "type": "number"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rulesNotInEffect": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safe": {
      "type": "boolean"
    },
    "secondsUntilSafe": {
      "type": "number"
    },
    "secondsUntilUnsafe": {
      "type": "number"
    }
  },
  "required": [
    "alpacaEnabled",
    "changedAgeMs",
    "evaluatedAgeMs",
    "rawSafe",
    "reasonFlags",
    "reasons",
    "rulesNotInEffect",
    "safe",
    "secondsUntilSafe"
  ],
  "additionalProperties": false
}
