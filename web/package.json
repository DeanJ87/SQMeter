{
  "name": "sqmeter-web-ui",
  "version": "0.0.1",
  "description": "SQMeter Web Interface",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "docs:vendor": "node scripts/vendor-mermaid.mjs && node scripts/vendor-esp-web-tools.mjs",
    "docs:diagrams": "node scripts/check-diagrams.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" .prettierrc.json"
  },
  "dependencies": {
    "preact": "^10.19.3",
    "preact-router": "^4.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.44.0",
    "@preact/preset-vite": "^2.7.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "esp-web-tools": "10.4.0",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "mermaid": "11.17.2",
    "msw": "^2.3.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.9",
    "terser": "^5.46.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.3"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
